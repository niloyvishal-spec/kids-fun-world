# Kids Game Collection - local environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# Enables the Ludo developer test mode:
#   - start the game:   LUDO_DEV_MODE=true npm run dev
#   - start the bot:    node server/telegram-ludo-dev.mjs
# Anything other than "true" keeps dev mode OFF (this is also enforced at
# build time: `vite build` never enables it).
LUDO_DEV_MODE=true

# Telegram bot token from @BotFather (required by telegram-ludo-dev.mjs).
# If this token was ever shared in chat, revoke it with @BotFather /revoke
# and issue a fresh one.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user ids allowed to control the game.
# Get yours from @userinfobot. Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Optional overrides (defaults shown):
# LUDO_DEV_URL=http://127.0.0.1:5173/ludo-dev/set
# LUDO_DEV_STATE_URL=http://127.0.0.1:5173/ludo-dev/state
