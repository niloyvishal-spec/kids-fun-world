    "test:buttons": "node e2e/buttons.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
